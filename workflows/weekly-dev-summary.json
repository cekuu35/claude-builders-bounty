{
  "name": "Weekly GitHub Development Summary (Claude)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "weeks", "triggerAtDay": ["5"], "triggerAtHour": 17, "triggerAtMinute": 0 }] } },
      "id": "schedule",
      "name": "Every Friday 17:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": { "assignments": { "assignments": [
        { "name": "owner", "value": "YOUR_GITHUB_OWNER", "type": "string" },
        { "name": "repo", "value": "YOUR_GITHUB_REPO", "type": "string" },
        { "name": "language", "value": "EN", "type": "string" },
        { "name": "model", "value": "claude-sonnet-4-20250514", "type": "string" },
        { "name": "slackWebhook", "value": "={{$env.SLACK_WEBHOOK_URL}}", "type": "string" }
      ] } },
      "id": "config",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": { "url": "=https://api.github.com/repos/{{$json.owner}}/{{$json.repo}}/commits?since={{$now.minus({days: 7}).toISO()}}&per_page=100", "options": { "response": { "response": { "responseFormat": "json" } } }, "headerParametersUi": { "parameter": [{ "name": "Accept", "value": "application/vnd.github+json" }] } },
      "id": "commits",
      "name": "Fetch commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, -180]
    },
    {
      "parameters": { "url": "=https://api.github.com/repos/{{$json.owner}}/{{$json.repo}}/issues?state=closed&since={{$now.minus({days: 7}).toISO()}}&per_page=100", "options": { "response": { "response": { "responseFormat": "json" } } }, "headerParametersUi": { "parameter": [{ "name": "Accept", "value": "application/vnd.github+json" }] } },
      "id": "issues",
      "name": "Fetch closed issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 0]
    },
    {
      "parameters": { "url": "=https://api.github.com/repos/{{$json.owner}}/{{$json.repo}}/pulls?state=closed&sort=updated&direction=desc&per_page=100", "options": { "response": { "response": { "responseFormat": "json" } } }, "headerParametersUi": { "parameter": [{ "name": "Accept", "value": "application/vnd.github+json" }] } },
      "id": "pulls",
      "name": "Fetch merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 180]
    },
    {
      "parameters": { "mode": "append", "numberInputs": 3 },
      "id": "merge",
      "name": "Combine GitHub results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [720, 0]
    },
    {
      "parameters": { "jsCode": "const input = $input.all().map(i => i.json);\nconst commits = input.find(x => Array.isArray(x) && x.some(v => v.sha)) || [];\nconst issues = input.find(x => Array.isArray(x) && x.some(v => v.pull_request === undefined && v.state)) || [];\nconst pulls = input.find(x => Array.isArray(x) && x.some(v => v.merged_at !== undefined)) || [];\nconst activity = { commits: commits.map(x => ({sha: x.sha, message: x.commit?.message?.split('\\n')[0], author: x.author?.login || x.commit?.author?.name})), closedIssues: issues.filter(x => !x.pull_request).map(x => ({number: x.number, title: x.title, url: x.html_url})), mergedPRs: pulls.filter(x => x.merged_at).map(x => ({number: x.number, title: x.title, url: x.html_url})) };\nreturn [{json: { ...$input.first().json, activity, prompt: `Write a concise weekly development summary in ${$input.first().json.language}. Use only the supplied facts. Include highlights, shipped changes, closed issues, merged PRs, risks, and next-week suggestions. If a category is empty, say so.\\n\\nFACTS:\\n${JSON.stringify(activity, null, 2)}` }}];" },
      "id": "prompt",
      "name": "Build summary prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 0]
    },
    {
      "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages", "sendHeaders": true, "headerParametersUi": { "parameter": [{ "name": "x-api-key", "value": "={{$env.ANTHROPIC_API_KEY}}" }, { "name": "anthropic-version", "value": "2023-06-01" }, { "name": "content-type", "value": "application/json" }] }, "sendBody": true, "jsonParameters": true, "bodyParametersJson": "={\"model\": $json.model, \"max_tokens\": 1200, \"messages\": [{\"role\": \"user\", \"content\": $json.prompt}]}" },
      "id": "claude",
      "name": "Generate with Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 0]
    },
    {
      "parameters": { "jsCode": "const text = $json.content?.[0]?.text || 'Claude returned no text.'; return [{json: {text, generatedAt: new Date().toISOString()}}];" },
      "id": "format",
      "name": "Format digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 0]
    },
    {
      "parameters": { "method": "POST", "url": "={{$env.SLACK_WEBHOOK_URL}}", "sendBody": true, "jsonParameters": true, "bodyParametersJson": "={\"text\": $json.text}" },
      "id": "slack",
      "name": "Deliver to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 0]
    }
  ],
  "connections": {
    "Every Friday 17:00": { "main": [[{ "node": "Configuration", "type": "main", "index": 0 }]] },
    "Configuration": { "main": [[{ "node": "Fetch commits", "type": "main", "index": 0 }, { "node": "Fetch closed issues", "type": "main", "index": 0 }, { "node": "Fetch merged PRs", "type": "main", "index": 0 }]] },
    "Fetch commits": { "main": [[{ "node": "Combine GitHub results", "type": "main", "index": 0 }]] },
    "Fetch closed issues": { "main": [[{ "node": "Combine GitHub results", "type": "main", "index": 1 }]] },
    "Fetch merged PRs": { "main": [[{ "node": "Combine GitHub results", "type": "main", "index": 2 }]] },
    "Combine GitHub results": { "main": [[{ "node": "Build summary prompt", "type": "main", "index": 0 }]] },
    "Build summary prompt": { "main": [[{ "node": "Generate with Claude", "type": "main", "index": 0 }]] },
    "Generate with Claude": { "main": [[{ "node": "Format digest", "type": "main", "index": 0 }]] },
    "Format digest": { "main": [[{ "node": "Deliver to Slack", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "weekly-dev-summary-v1"
}
